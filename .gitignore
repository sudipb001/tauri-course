# ---------------------------------
# Tauri v2 Course - .gitignore
# ---------------------------------

# Node / npm
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# Frontend build output
dist/
dist-ssr/
build/

# Rust / Cargo build output
target/
**/target/
*.pdb

# Standalone lecture executables (compiled with rustc directly)
lecture-*/main.exe
lecture-*/main
lecture-*/*.exe
lecture-*/*.o

# Tauri build artifacts
src-tauri/target/
src-tauri/gen/
src-tauri/WixTools/
src-tauri/Cargo.lock

# Environment files
.env
.env.local
*.env

# Local settings / preferences generated while running FileFlow
*.local.json
store.json

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Logs
*.log